{
  "name": "mac-style-terminal-desktop",
  "version": "0.2.0",
  "description": "A rounded terminal for Windows and Linux",
  "author": "songyekun-614",
  "license": "UNLICENSED",
  "main": "src/main.cjs",
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.cjs",
    "test:e2e": "playwright test test/desktop.spec.cjs --workers=1",
    "pack": "npm run build && electron-builder --dir",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "node-pty": "1.1.0",
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "@playwright/test": "1.64.0"
  },
  "desktopName": "terminal",
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": "https://github.com/songyekun-614/terminal",
  "repository": {
    "type": "git",
    "url": "https://github.com/songyekun-614/terminal.git"
  }
}
